{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resolved Solve Plan V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "name", "study", "samples", "solver", "boundaries", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "study": {"enum": ["kinematic", "quasi_static", "dynamic"]},
    "samples": {"type": "array", "minItems": 1, "items": {"type": "number", "finite": true}},
    "solver": {"type": "object"},
    "initial_state": {"type": "object"},
    "protocol": {"enum": ["kc_quasi_static", "axle_dynamic", "vehicle_kc", "vehicle_dynamic", "handling", "ride_four_post", "ride_random_road", "comparison"]},
    "excitation": {"type": "object"},
    "element_activation": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["entity", "active"],
      "properties": {"entity": {"type": "string", "minLength": 1}, "active": {"type": "boolean"}}
    }},
    "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "characteristics": {"$ref": "#/$defs/characteristics"}
  },
  "$defs": {
    "declaration": {
      "type": "object", "additionalProperties": false,
      "required": ["measurement_id", "definition_version", "units", "response_kind", "response_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "measurement_id": {"type": "string", "minLength": 1},
        "definition_version": {"type": "integer", "minimum": 1},
        "units": {"type": "string", "minLength": 1},
        "response_kind": {"type": "string", "minLength": 1},
        "response_version": {"type": "integer", "minimum": 1},
        "mode": {"type": "string", "minLength": 1}
      }
    },
    "characteristics": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "domain", "samples", "measurements", "boundary", "definition", "response_operator"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "domain": {"enum": ["kinematic", "equilibrium", "trajectory", "dynamic"]},
        "samples": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "measurements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/declaration"}},
        "perturbations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/declaration"}},
        "boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["profile", "version"],
          "properties": {
            "profile": {"type": "string", "minLength": 1},
            "version": {"type": "integer", "minimum": 1},
            "released": {"type": "array", "items": {"type": "string"}},
            "held": {"type": "array", "items": {"type": "string"}}
          }
        },
        "definition": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "version"],
          "properties": {
            "kind": {"enum": ["frozen_force_tangent", "frozen_load_compliance", "continuous_descriptor"]},
            "version": {"type": "integer", "minimum": 1}
          }
        },
        "frozen_conditions": {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "version"],
          "properties": {
            "protocol": {"type": "string", "minLength": 1},
            "version": {"type": "integer", "minimum": 1}
          }
        },
        "response_operator": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "version"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "version": {"type": "integer", "minimum": 1}
          }
        },
        "wheel_end_response": {"type": "object"}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "coordinate", "mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "coordinate": {"type": "string", "minLength": 1},
        "mode": {"enum": ["free", "locked", "prescribed_angle", "prescribed_displacement", "prescribed_speed"]},
        "value": {"type": "number", "finite": true},
        "program": {"type": "string"},
        "units": {"enum": ["rad", "rad/s", "m", "m/s"]}
      }
    }
  }
}
