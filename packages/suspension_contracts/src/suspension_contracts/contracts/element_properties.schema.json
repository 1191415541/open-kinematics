{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-kinematics.dev/contracts/element_properties_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema_version", "name", "element_type", "model", "units"],
  "properties": {
    "document": {"const": "element_properties"},
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "element_type": {"enum": ["spring", "damper", "bump_stop", "bushing", "tire"]},
    "model": {"enum": ["linear", "nonlinear", "piecewise"]},
    "units": {
      "type": "object", "additionalProperties": false, "required": ["force", "length"],
      "properties": {
        "force": {"type": "string", "minLength": 1},
        "length": {"type": "string", "minLength": 1},
        "time": {"type": "string", "minLength": 1},
        "mass": {"type": "string", "minLength": 1}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {"type": "number", "finite": true}
    },
    "matrix": {
      "type": "object", "additionalProperties": false, "required": ["name", "rows"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "rows": {
          "type": "array", "minItems": 1,
          "items": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 1}
        }
      }
    },
    "curve": {
      "type": "object", "additionalProperties": false, "required": ["independent", "dependent", "points"],
      "properties": {
        "independent": {"type": "string", "minLength": 1},
        "dependent": {"type": "string", "minLength": 1},
        "interpolation": {"enum": ["piecewise_linear", "akima"]},
        "points": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 2, "maxItems": 2},
          "minItems": 2
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
