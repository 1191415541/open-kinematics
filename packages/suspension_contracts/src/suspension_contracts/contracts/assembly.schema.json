{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-kinematics.dev/contracts/assembly_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema_version", "name", "assembly_kind", "subsystems"],
  "properties": {
    "document": {"const": "assembly"},
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "assembly_kind": {"enum": ["suspension_axle", "full_vehicle"]},
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "functional_role", "placement_role"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "functional_role": {"enum": ["suspension", "steering", "wheel", "chassis", "brake", "drive"]},
          "placement_role": {"enum": ["any", "front", "rear", "front_left", "front_right", "rear_left", "rear_right"]},
          "overrides": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "hardpoints": {
                "type": "object",
                "additionalProperties": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 3, "maxItems": 3}
              },
              "property_bindings": {
                "type": "object",
                "additionalProperties": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "rig": {"type": "string", "minLength": 1}
  }
}
