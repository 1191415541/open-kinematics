{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-kinematics.dev/contracts/assembly_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema_version", "name", "assembly_kind", "subsystems"],
  "properties": {
    "document": {"const": "assembly"},
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "mode": {"enum": ["K", "C"]},
    "gravity": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 3, "maxItems": 3},
    "road": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["plane", "sine", "bump", "random_fourier", "four_post"]}, "parameters": {"type": "object"}}},
    "couplers": {"type": "array", "items": {"type": "object"}},
    "measurements": {"type": "array", "items": {"type": "object"}},
    "connections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "port_a", "port_b", "type"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "port_a": {"type": "string", "minLength": 1},
          "port_b": {"type": "string", "minLength": 1},
          "type": {"enum": ["fixed", "revolute", "spherical", "prismatic", "universal", "cylindrical", "inplane", "bushing", "driven_translation", "driven_rotation"]},
          "axis": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 3, "maxItems": 3},
          "axis_b": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 3, "maxItems": 3},
          "target": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "units": {
            "type": "object", "additionalProperties": false,
            "required": ["length"],
            "properties": {"length": {"enum": ["m", "mm"]}}
          },
          "modes": {"type": "array", "items": {"enum": ["K", "C"]}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "assembly_kind": {"enum": ["suspension_axle", "full_vehicle", "generic_multibody"]},
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "functional_role", "placement_role"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "functional_role": {"enum": ["suspension", "steering", "wheel", "chassis", "brake", "drive", "anti_roll_bar", "generic"]},
          "placement_role": {"type": "string", "minLength": 1, "description": "Where this subsystem sits.  The axis words (front, middle, rear, third, ...) are the file's own vocabulary: a three-axle truck names three, and the shape rule checks that each one appears at most once and that every declared wheel end is accounted for, rather than fixing the list here."},
          "placement": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "translation": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 3, "maxItems": 3},
              "quaternion": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 4, "maxItems": 4}
            }
          },
          "overrides": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "hardpoints": {
                "type": "object",
                "additionalProperties": {"type": "array", "items": {"type": "number", "finite": true}, "minItems": 3, "maxItems": 3}
              },
              "property_bindings": {
                "type": "object",
                "additionalProperties": {"type": "string", "minLength": 1}
              }
            }
          },
          "pairings": {
            "description": "Explicit pairings, one per requirement this assignment wants to settle by hand: each entry names a requirement role and the port that must satisfy it.  Optional, and absent means 'match by role and capability', so a file that states nothing keeps the inferred behaviour.  A file that states a pairing makes it the source of truth for that requirement.",
            "type": "array",
            "items": {"$ref": "#/$defs/pairing"}
          }
        }
      }
    },
    "rig": {"type": "string", "minLength": 1},
    "vehicle": {
      "description": "The vehicle-level numbers a full-vehicle assembly needs and its subsystems do not carry: the chassis body, the four wheel ends, the steering system and the driveline.  Each is validated here as an object and in full by the model's own class, so a bound such as 'steering ratio must be positive' has one home rather than two that can disagree.",
      "type": "object",
      "additionalProperties": false,
      "required": ["wheels", "steering"],
      "properties": {
        "chassis": {"$ref": "#/$defs/vehicle_part"},
        "wheels": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/vehicle_part"}
        },
        "steering": {"$ref": "#/$defs/vehicle_part"},
        "steering_channels": {
          "description": "The additional steering channels beyond the mandatory compatibility primary, each naming the placement it steers.  A vehicle with none of them is exactly what it always was.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/vehicle_part"}
        },
        "driveline": {"$ref": "#/$defs/vehicle_part"}
      }
    }
  },
  "$defs": {
    "pairing": {
      "description": "One explicit pairing: the requirement being settled and the port name that settles it.  Both ends are required, because a pairing missing either one states nothing that can be acted on.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_role", "port"],
      "properties": {
        "requirement_role": {"type": "string", "minLength": 1},
        "port": {"type": "string", "minLength": 1}
      }
    },
    "vehicle_part": {
      "description": "One vehicle-level object, in the model's own shape.  The fields are the schema class's; stating them a second time here would let the two sets of bounds drift apart.",
      "type": "object"
    }
  }
}
